# RSVPs go straight to your Google Sheet.
# Follow README → "RSVPs in a Google Sheet" to get these two values.

# The Apps Script Web app URL (ends in /exec)
RSVP_SHEET_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Must match SECRET in the Apps Script exactly
RSVP_SHEET_SECRET=the-same-long-random-phrase
