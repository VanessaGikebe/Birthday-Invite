# ── RSVP storage (Supabase) ────────────────────────────────────────────
# Create a project at https://supabase.com, run supabase/schema.sql in the
# SQL editor, then copy these from Project Settings → API.
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Host dashboard (/host) ─────────────────────────────────────────────
HOST_PASSWORD=choose-a-long-password
# Optional: separate secret for signing the host session cookie (defaults to HOST_PASSWORD)
HOST_SESSION_SECRET=

# ── Local development only ─────────────────────────────────────────────
# Without Supabase, `npm run dev` stores RSVPs in .data/rsvps.json.
# Set RSVP_STORAGE=file to force file storage on a self-hosted server with a persistent disk.
# RSVP_STORAGE=file
